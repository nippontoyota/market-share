{
  "name": "performance-dashboard",
  "version": "1.0.0",
  "description": "RTO Analytics Dashboard with secure authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "updater": "node local_updater.js",
    "refresh:vahan": "python automation/run_full_pipeline.py",
    "refresh:vahan:existing": "python automation/run_full_pipeline.py --skip-download",
    "test:automation": "python -m pytest tests"
